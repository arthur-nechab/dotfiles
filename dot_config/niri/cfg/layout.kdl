// ── Layout ───────────────────────────────────────────────────────────

layout {
    gaps 16
    center-focused-column "never"

    // noctalia draws the wallpaper behind the workspace view
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    struts {
        top -5
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=4
        color "#1a1a1aee"
    }

    focus-ring {
        width 1
        active-gradient from="#928374aa" to="#a89984aa" angle=45 relative-to="workspace-view"
        inactive-color "#45475aaa"
    }

    border {
        width 1
        active-gradient from="#928374aa" to="#a89984aa" angle=45 relative-to="workspace-view"
        inactive-color "#45475aaa"
    }
}
