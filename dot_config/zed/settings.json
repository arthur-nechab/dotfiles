{
  // ── Appearance ─────────────────────────────────────────────────────
  "theme": "Gruvbox Baby",
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": "BerkeleyMono Nerd Font",
  "buffer_font_size": 16,

  // ── Editor ─────────────────────────────────────────────────────────
  "relative_line_numbers": "enabled",
  "show_whitespaces": "trailing",
  "autosave": "on_focus_change",

  // ── Panels ─────────────────────────────────────────────────────────
  "project_panel": {
    "dock": "left",
    "entry_spacing": "standard",
    "git_status_indicator": true,
    "indent_size": 15
  },
  "git_panel": {
    "entry_primary_click_action": "file_diff",
    "file_icons": true,
    "tree_view": true
  },
  "collaboration_panel": {
    "button": false
  },

  // ── Git ────────────────────────────────────────────────────────────
  "diff_view_style": "unified",

  // ── Terminal ───────────────────────────────────────────────────────
  "terminal": {
    "font_family": "BerkeleyMono Nerd Font",
    "working_directory": "always_home"
  },

  // ── Session ────────────────────────────────────────────────────────
  "session": {
    "trust_all_worktrees": true
  },

  // ── Privacy ────────────────────────────────────────────────────────
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  // ── File type overrides ────────────────────────────────────────────
  "file_types": {
    "Shell Script": ["dot_zshenv.tmpl", "dot_zshrc.tmpl", "dot_zprofile.tmpl"],
    "Git Ignore": [".chezmoiignore", "ignore"],
    "TOML": [".chezmoi.toml.tmpl"],
    "INI": ["config.tmpl"],
    "JSONC": ["config"],
    "Ruby": ["Brewfile"],
    "Jinja2": ["*.j2", "*.jinja", "*.jinja2"]
  }
}
