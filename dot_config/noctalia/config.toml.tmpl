[audio]
enable_sounds = false

[backdrop]
enabled = true
blur_intensity = 0.6
tint_intensity = 0.35

[bar.default]
background_opacity = 0.85
center = [ "date", "clock" ]
end = [ "tray", "spacer_3", "clipboard", "network", "vpn", "bluetooth", "input_volume", "volume", "battery", "notifications" ]
margin_edge = 6
start = [ "control-center", "workspaces", "spacer_1", "cpu", "gpu", "ram" ]
widget_spacing = 8
contact_shadow = true

[control_center]
shortcuts = [
    { type = "wifi" },
    { type = "bluetooth" },
    { type = "local/bt-audio:tile" },
    { type = "caffeine" },
    { type = "notification" },
    { type = "power_profile" },
]

[control_center.calendar]
show_events_card = false
show_week_numbers = true

[notification]
follow_focused_output = true

[idle]
pre_action_fade_seconds = 0

[idle.behavior.lock]
enabled = true
action = "lock"
timeout = 300.0

[idle.behavior.screen-off]
enabled = true
action = "screen_off"
timeout = 600.0

[[shell.session.actions]]
action = "logout"

[[shell.session.actions]]
action = "reboot"

[[shell.session.actions]]
action = "shutdown"

[osd]
follow_focused_output = true

[location]
auto_locate = true
custom_schedule = true
sunrise = "07:30"
sunset = "20:30"

[lockscreen]
transition = [ "fade" ]
transition_duration = 0
blur_intensity = 0.8

{{- /* output, logical width, logical height: the native size divided by the scale that
     hypr/hyprland.lua picks. Noctalia 5.3 matches a login box by connector only, so list
     every DP-N the dock gives the external screen. */ -}}
{{- $outputs := list (list "eDP-1" 1536 960) (list "DP-1" 2560 1440) (list "DP-2" 2560 1440) (list "DP-10" 2560 1440) (list "DVI-I-1" 1920 1080) (list "DVI-I-2" 1920 1080) }}

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [ {{ range $i, $o := $outputs }}{{ if $i }}, {{ end }}"lockscreen-clock@{{ index $o 0 }}", "lockscreen-date@{{ index $o 0 }}", "lockscreen-login-box@{{ index $o 0 }}"{{ end }} ]
{{ range $o := $outputs }}
{{- $n := index $o 0 }}{{ $w := float64 (index $o 1) }}{{ $h := float64 (index $o 2) }}
    [lockscreen_widgets.widget."lockscreen-clock@{{ $n }}"]
    box_height = 140.0
    box_width = 400.0
    cx = {{ printf "%.1f" (divf $w 2) }}
    cy = {{ printf "%.1f" (subf (divf $h 2) 198) }}
    output = "{{ $n }}"
    placement_height = {{ printf "%.1f" $h }}
    placement_width = {{ printf "%.1f" $w }}
    rotation = 0.0
    type = "clock"

        [lockscreen_widgets.widget."lockscreen-clock@{{ $n }}".settings]
        background_opacity = 0.0
        font_family = "Inter"
        format = "{:%H:%M}"

    [lockscreen_widgets.widget."lockscreen-date@{{ $n }}"]
    box_height = 45.0
    box_width = 400.0
    cx = {{ printf "%.1f" (divf $w 2) }}
    cy = {{ printf "%.1f" (subf (divf $h 2) 105.5) }}
    output = "{{ $n }}"
    placement_height = {{ printf "%.1f" $h }}
    placement_width = {{ printf "%.1f" $w }}
    rotation = 0.0
    type = "clock"

        [lockscreen_widgets.widget."lockscreen-date@{{ $n }}".settings]
        background_opacity = 0.0
        font_family = "Inter"
        format = "{:%A %d %B}"

    [lockscreen_widgets.widget."lockscreen-login-box@{{ $n }}"]
    # the compact layout sets its own height; a box_height of 0 would also reset box_width
    box_height = 196.0
    box_width = 380.0
    cx = {{ printf "%.1f" (divf $w 2) }}
    cy = {{ printf "%.1f" (divf $h 2) }}
    output = "{{ $n }}"
    placement_height = {{ printf "%.1f" $h }}
    placement_width = {{ printf "%.1f" $w }}
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@{{ $n }}".settings]
        background_color = "surface_variant"
        background_opacity = 0.0
        background_radius = 12.0
        center_password_text = true
        input_opacity = 0.85
        input_radius = 6.0
        layout = "compact"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = false
        show_media = false
        show_password_reveal = false
        show_session_buttons = false
        show_unlock_hint = false
        show_weather = false
{{ end }}[nightlight]
enabled = true

[plugins]
enabled = [ "noctalia/screen_recorder", "local/bt-audio", "local/vpn-status" ]

[shell]
telemetry_enabled = false
font_family = "Inter"
niri_overview_type_to_launch_enabled = true
polkit_agent = true
settings_show_advanced = false

    [shell.animation]
    speed = 1.5

    [shell.launcher]
    layout = "simple"
    categories = false
    show_app_origin_indicator = false
    compact = true

        [shell.launcher.providers.calculator]
        global = true

        [shell.launcher.providers.windows]
        global = true

    [shell.screen_corners]
    enabled = true

    [shell.screenshot]
    directory = "{{ .chezmoi.homeDir }}/Pictures/Screenshots"

[theme]
source = "wallpaper"
wallpaper_scheme = "vibrant"

    [theme.templates]
    builtin_ids = [ "gtk3", "gtk4", "ghostty", "btop", "hyprland" ]

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/Pictures/Wallpapers"
transition = [ "fade" ]
transition_duration = 1200
edge_smoothness = 0.15

[widget.vpn]
type = "local/vpn-status:widget"

[widget.battery]
show_label = false

[widget.cpu]
show_value = true
visualization = "graph"

[widget.gpu]
type = "sysmon"
show_value = true
stat = "gpu_usage"
visualization = "gauge"

[widget.date]
format = "{:%d %b}"

[widget.input_volume]
show_label = false

[widget.spacer_1]
type = "spacer"

[widget.spacer_3]
type = "spacer"

[widget.network]
vpn_status = "hidden"
show_label = false

[widget.volume]
show_label = false

[plugin_settings."noctalia/screen_recorder"]
video_source = "portal"
directory = "{{ .chezmoi.homeDir }}/Videos/Recordings"
