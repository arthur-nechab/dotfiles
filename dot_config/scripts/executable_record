#!/bin/sh
# toggle a region recording; the same key stops it
if pgrep -x wf-recorder >/dev/null; then
    pkill -INT wf-recorder
    sleep 1
    last=$(ls -t ~/Videos/*.mp4 | head -1)
    notify-send "Screen recording saved" "$(basename "$last") · $(du -h "$last" | cut -f1)"
    exit 0
fi

selection=$(slurp 2>/dev/null) || exit 0
[ -z "$selection" ] && exit 0
exec wf-recorder -g "$selection" -c h264_nvenc \
    -p preset=p5 -p tune=hq -p rc=vbr -p cq=22 -r 60 \
    -f ~/Videos/"$(date +%Y%m%d_%H%M%S)".mp4
