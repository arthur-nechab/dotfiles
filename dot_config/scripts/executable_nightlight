#!/bin/sh
# hyprsunset front end; no argument prints "<kelvin> warm|cool" for the bar
state=${XDG_RUNTIME_DIR:-/tmp}/nightlight_warm_temp

read_temp() {
    t=$(hyprctl hyprsunset temperature 2>/dev/null)
    case $t in
        ''|*[!0-9]*) echo 6500 ;;
        *) echo "$t" ;;
    esac
}
current=$(read_temp)

case ${1:-} in
    --toggle)
        pgrep -x hyprsunset >/dev/null || { hyprsunset -t 6500 & }
        sleep 0.2
        current=$(read_temp)
        if [ "$current" -le 4500 ]; then
            echo "$current" > "$state"
            hyprctl hyprsunset temperature 6500
        else
            hyprctl hyprsunset temperature "$(cat "$state" 2>/dev/null || echo 3500)"
        fi
        ;;
    --up)
        new=$((current + 200))
        [ "$new" -gt 6500 ] && new=6500
        hyprctl hyprsunset temperature "$new"
        ;;
    --down)
        new=$((current - 200))
        [ "$new" -lt 1000 ] && new=1000
        hyprctl hyprsunset temperature "$new"
        ;;
    *)
        if [ "$current" -le 4500 ]; then echo "$current warm"; else echo "$current cool"; fi
        ;;
esac
