#!/usr/bin/env bash

CACHE="$HOME/.cache/hypr/current-wallpaper"
CONF="$HOME/.config/hypr/hyprpaper.conf"
FALLBACK=$(find "$HOME/Pictures/Wallpapers" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) | sort | head -1)

WALL="$FALLBACK"
if [[ -f "$CACHE" ]]; then
    CACHED=$(cat "$CACHE")
    [[ -f "$CACHED" ]] && WALL="$CACHED"
fi

monitors=$(hyprctl monitors -j | jq -r '.[].name')

{
    echo "splash = false"
    echo "ipc = true"
    echo ""
    while IFS= read -r mon; do
        echo "wallpaper {"
        echo "    monitor = $mon"
        echo "    path = $WALL"
        echo "    fit_mode = cover"
        echo "}"
    done <<< "$monitors"
} > "$CONF"

exec hyprpaper
