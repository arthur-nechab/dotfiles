#!/bin/sh
# the selection, or the folder itself when nothing is selected
# Debian ships the binary as zed, Arch as zeditor
zed=$(command -v zeditor || command -v zed) || exit 1
[ $# -gt 0 ] && exec "$zed" "$@"
exec "$zed" "$(printf '%s' "$NAUTILUS_SCRIPT_CURRENT_URI" | sed 's#^file://##' | python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.stdin.read().strip()))')"
